---
import pez from '../assets/pez.png';
---
<section id="contact" class="w-[min(90%,120rem)] mx-auto mt-16 px-8 py-16 relative min-h-[40vh] z-10 overflow-visible">
    <div class="text-center mb-20 relative w-full">
        <h2 class="text-[4rem] text-white font-bold inline-block relative pb-6 m-0 capitalize drop-shadow-[0_3px_6px_rgba(0,29,61,0.5)] after:content-[''] after:absolute after:bottom-0 after:left-1/2 after:-translate-x-1/2 after:w-[80px] after:h-[5px] after:bg-gradient-to-r after:from-marine-deep after:via-marine-teal after:to-marine-deep after:bg-[length:200%_auto] after:rounded-full after:shadow-[0_0_10px_rgba(0,206,209,0.5)] after:animate-[flowLine_3s_linear_infinite]" data-key="contact.title">Contacto</h2>
    </div>
    
    <form id="formulario-contacto" class="bg-white/10 p-12 rounded-2xl max-w-[60rem] mx-auto backdrop-blur-sm border border-white/20 relative z-10">
        <div class="mb-8">
            <label for="fullName" class="block text-white mb-2 font-bold" data-key="contact.name">Nombre</label>
            <input type="text" id="fullName" name="fullName" placeholder="Tu Nombre" required class="w-full p-6 border-none rounded-lg font-body text-black bg-white/90 focus:outline-none focus:ring-2 focus:ring-marine-teal">
        </div>
        <div class="mb-8">
            <label for="email" class="block text-white mb-2 font-bold" data-key="contact.email">Email</label>
            <input type="email" id="email" name="email" placeholder="Tu Email" required class="w-full p-6 border-none rounded-lg font-body text-black bg-white/90 focus:outline-none focus:ring-2 focus:ring-marine-teal">
        </div>
        <div class="mb-8">
            <label for="message" class="block text-white mb-2 font-bold" data-key="contact.message">Mensaje</label>
            <textarea id="message" name="message" placeholder="Escribe tu mensaje..." required class="w-full p-6 border-none rounded-lg font-body text-black bg-white/90 focus:outline-none focus:ring-2 focus:ring-marine-teal h-[15rem] resize-none"></textarea>
        </div>
        <div class="flex justify-end">
            <button type="submit" class="bg-marine-teal text-marine-deep px-12 py-5 border-2 border-marine-teal rounded-md text-lg font-bold cursor-pointer transition-all inline-flex items-center justify-center gap-4 text-center shadow-[0_4px_15px_rgba(0,206,209,0.3)] hover:bg-[#023e8a] hover:border-[#023e8a] hover:text-white hover:-translate-y-1 hover:shadow-[0_6px_20px_rgba(2,62,138,0.4)]" data-key="contact.send">Enviar Mensaje</button>
        </div>
    </form>

    <!-- Deep Ocean Fish Animation (Inside Contact) -->
    <div id="deep-ocean-fish" class="absolute bottom-0 left-1/2 -translate-x-1/2 w-screen h-full pointer-events-none z-1">
        <img src={pez.src} alt="Swimming Fish" class="w-[25rem] absolute bottom-[15rem] -left-[30rem] drop-shadow-[0_0_20px_rgba(0,255,255,0.8)] drop-shadow-[0_0_40px_rgba(0,206,209,0.4)] animate-[swim_40s_linear_infinite] z-1">
    </div>
</section>
