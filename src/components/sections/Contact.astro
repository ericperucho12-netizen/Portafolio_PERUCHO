---
// @ts-nocheck
import buceando from '../../assets/buceando (1).png';
import pezAvizal from '../../assets/pezAvizal.png';
---
<section id="contact" class="w-full mx-auto mt-16 px-4 md:px-8 pt-16 pb-8 relative z-10 overflow-visible">
    <div class="text-center mb-20 relative w-full">
        <h2 class="scroll-float text-[4rem] text-white font-bold inline-block relative pb-6 m-0 capitalize drop-shadow-[0_3px_6px_rgba(0,29,61,0.5)] after:content-[''] after:absolute after:bottom-0 after:left-1/2 after:-translate-x-1/2 after:w-[80px] after:h-[5px] after:bg-gradient-to-r after:from-marine-deep after:via-marine-teal after:to-marine-deep after:bg-[length:200%_auto] after:rounded-full after:shadow-[0_0_10px_rgba(0,206,209,0.5)] after:animate-[flowLine_3s_linear_infinite]" data-key="contact.title">Contacto</h2>
    </div>
    
    <!-- Tarjeta de Contacto con Email Copiable -->
    <div class="scroll-reveal w-[95%] max-w-[55rem] mx-auto relative z-10 mt-10 flex flex-col items-center">
        <div class="w-full bg-[#03050c]/60 p-12 md:p-16 rounded-[2.5rem] backdrop-blur-xl border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.7)] flex flex-col items-center justify-center text-center">
            
            <h3 class="text-3xl md:text-4xl font-bold text-white mb-4 drop-shadow-md" data-key="contact.subtitle">Do you have an idea in mind?</h3>
            <p class="text-gray-300 text-lg md:text-xl mb-12 max-w-[45ch]" data-key="contact.description">Write me an email and let's build something amazing together from the depths of the web.</p>

            <!-- Email copiable -->
            <div class="flex flex-col items-center gap-6 w-full">
                <div 
                    id="email-copy-box"
                    class="group flex items-center gap-4 bg-[#03050c]/80 border border-white/20 rounded-2xl px-8 py-5 cursor-pointer hover:border-[#00ced1] hover:shadow-[0_0_20px_rgba(0,206,209,0.3)] transition-all duration-300 w-full max-w-md justify-between"
                    onclick="copyEmail()"
                    title="Click to copy"
                >
                    <!-- Ícono correo -->
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-[#00ced1] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                    </svg>

                    <span class="text-white text-xl font-mono tracking-wide flex-1 text-left" id="email-text">ericperucho12@gmail.com</span>

                    <!-- Ícono copiar -->
                    <svg id="icon-copy" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-gray-400 group-hover:text-[#00ced1] transition-colors flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 01-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 011.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 00-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 01-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 00-3.375-3.375h-1.5a1.125 1.125 0 01-1.125-1.125v-1.5a3.375 3.375 0 00-3.375-3.375H9.75" />
                    </svg>
                    <!-- Ícono check (aparece al copiar) -->
                    <svg id="icon-check" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-green-400 flex-shrink-0 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                </div>

                <!-- Mensaje de confirmación -->
                <p id="copy-feedback" class="text-green-400 text-sm font-semibold opacity-0 transition-opacity duration-300" data-key="contact.copied">✓ Email copied to clipboard!</p>
            </div>
        </div>
    </div>

    <!-- Escena Abisal (Buceando y Pez Abisal) flotante, sin ocupar espacio de layout -->
    <div id="deep-ocean-scene" class="absolute bottom-[-50px] md:bottom-[-100px] left-0 w-full pointer-events-none z-1 overflow-visible">
        
        <!-- Eric Buceando (A la izquierda, más grande) -->
        <div class="absolute left-[-20px] md:left-[5%] lg:left-[10%] bottom-[40px] md:bottom-[70px] z-10 animate-[float_6s_ease-in-out_infinite]">
            <img 
                src={buceando.src} 
                alt="Buceando" 
                class="w-[200px] md:w-[350px] lg:w-[450px] drop-shadow-[0_10px_20px_rgba(0,0,0,0.5)]"
            >
        </div>
        
        <!-- Pez Abisal Brillante (Se aleja y da la vuelta) -->
        <div class="absolute left-[150px] md:left-[35%] lg:left-[35%] bottom-[20px] md:bottom-[50px] animate-[swimAround_18s_linear_infinite]">
            <img 
                src={pezAvizal.src} 
                alt="Pez Abisal" 
                class="w-[100px] md:w-[180px] lg:w-[250px]"
            >
        </div>
    </div>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
  }

  @keyframes swimAround {
    0%, 10% { 
        transform: translate(0, 0) scaleX(1); /* Mirando a Eric */
        filter: drop-shadow(0 0 50px rgba(0, 255, 255, 1)); 
    }
    15% {
        transform: translate(0, 0) scaleX(-1); /* Se voltea a la derecha */
        filter: drop-shadow(0 0 20px rgba(0, 255, 255, 0.4));
    }
    45% { 
        transform: translate(45vw, -30px) scaleX(-1); /* Nada hacia la derecha */
        filter: drop-shadow(0 0 20px rgba(0, 255, 255, 0.4)); 
    }
    50%, 60% { 
        transform: translate(45vw, -30px) scaleX(1); /* Se voltea a la izquierda */
        filter: drop-shadow(0 0 50px rgba(0, 255, 255, 1)); 
    }
    90% { 
        transform: translate(0, 0) scaleX(1); /* Nada de regreso */
        filter: drop-shadow(0 0 20px rgba(0, 255, 255, 0.4)); 
    }
    100% { 
        transform: translate(0, 0) scaleX(1); 
        filter: drop-shadow(0 0 50px rgba(0, 255, 255, 1)); 
    }
  }
</style>
</section>
