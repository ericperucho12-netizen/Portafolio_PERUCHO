---
import InfiniteMenu from "../ui/InfiniteMenu.jsx";
import yoCallendo from "../../assets/Yo_callendo.png";
import htmlIcon from "../../assets/HTMl.webp";
import javaIcon from "../../assets/Java.png";
import jsIcon from "../../assets/JavaScript.png";
import cssIcon from "../../assets/CSS.webp";
import cppIcon from "../../assets/C++.png";
import pythonIcon from "../../assets/Python-logo-notext.svg.png";
import postgresIcon from "../../assets/Postgresql_elephant.svg";
import nodeIcon from "../../assets/nodejs-200.png";
import mysqlIcon from "../../assets/My SQL.png";

// Imágenes de galería
import imgAmigos from "../../assets/Amigos_menu.jpeg";
import imgDog from "../../assets/Dog_menu.jpeg";
import imgElegante from "../../assets/Elegante_menu.jpeg";
import imgElegant from "../../assets/Elegant_menu.jpeg";
import imgFriendst from "../../assets/Friendst_menu.jpeg";
import imgJapon from "../../assets/Japon_menu.jpeg";
import imgMoure from "../../assets/Moure_menu.jpeg";
import imgParacaidas from "../../assets/Paracaidas_menu.jpeg";
import imgPoli2 from "../../assets/Poli2_menu.jpeg";
import imgPoli from "../../assets/Poli_menu.jpeg";
import imgViaje from "../../assets/Viaje_menu.jpeg";
---

<section
  id="about"
  class="w-full mx-auto mt-16 px-4 md:px-12 py-16 relative min-h-[40vh] z-10"
>
  <div class="bg-transparent mb-20">
    <div class="text-center mb-20 relative w-full">
      <h2
        class="scroll-float text-[4rem] text-white font-bold inline-block relative pb-6 m-0 capitalize drop-shadow-[0_3px_6px_rgba(0,29,61,0.5)] after:content-[''] after:absolute after:bottom-0 after:left-1/2 after:-translate-x-1/2 after:w-[80px] after:h-[5px] after:bg-gradient-to-r after:from-marine-deep after:via-marine-teal after:to-marine-deep after:bg-[length:200%_auto] after:rounded-full after:shadow-[0_0_10px_rgba(0,206,209,0.5)] after:animate-[flowLine_3s_linear_infinite]"
        data-key="about.title"
      >
        About
      </h2>
    </div>

    <div
      class="flex flex-col lg:flex-row items-center justify-between gap-12 lg:gap-20 mb-20 relative w-full"
    >
      <!-- Foto Profile (Izquierda en desktop, Centro en mobile) -->
      <div class="flex justify-center lg:flex-[1.2] w-full">
        <div
          class="absolute inset-0 bg-marine-teal/20 rounded-full blur-[50px] transition-all duration-700 group-hover:bg-marine-teal/40 group-hover:blur-[70px]"
        >
        </div>
        <img
          src={yoCallendo.src}
          alt="Eric Cayendo"
          class="w-full lg:min-w-[45rem] lg:scale-100 h-auto object-contain relative z-10 drop-shadow-[0_15px_30px_rgba(0,0,0,0.6)] animate-[float_5s_ease-in-out_infinite] transition-transform duration-500 hover:scale-110 hover:-translate-y-4"
        />
      </div>
      <div class="w-full lg:flex-1">
        <p
          class="scroll-reveal text-[1.8rem] text-gray-300 mb-8 text-justify font-body leading-relaxed z-10 relative drop-shadow-md"
          data-key="about.p1"
        >
          Hi! I'm Eric Perucho. My coding journey started with a clear goal: to understand how things work from the inside out. I'm a Full Stack Developer with a background in systems analysis, but more than that, I'm passionate about solving problems and never stopping learning.
        </p>
        <p
          class="scroll-reveal text-[1.8rem] text-gray-300 mb-8 text-justify font-body leading-relaxed z-10 relative drop-shadow-md"
          data-key="about.p2"
        >
          I recently decided to take my learning to the next level by creating Perucho Dev, a space where I share my process of mastering programming logic and languages like Java and Python. I don't just look to build robust software; my goal is to design solutions that truly make the user's life easier.
        </p>
        <p
          class="scroll-reveal text-[1.8rem] text-gray-300 mb-8 text-justify font-body leading-relaxed z-10 relative drop-shadow-md"
          data-key="about.p3"
        >
          I am currently in the process of graduating and always look for environments where precision and teamwork are key. If anything defines me, it's my insatiable curiosity: if I don't know it, I research it; if I learn it, I explain it to you.
        </p>

        <blockquote
          class="mt-12 border-l-4 border-[#00ffff] pl-8 italic bg-white/5 p-4 rounded-r-lg"
        >
          <p
            class="font-serif text-[2rem] text-white mb-4 drop-shadow-md"
            data-key="about.quote"
          >
            "The sea, once it casts its spell, holds one in its net of wonder forever."
          </p>
          <footer
            class="text-right font-bold text-gray-400 text-[1.6rem]"
            data-key="about.author"
          >
            - Jacques Yves Cousteau
          </footer>
        </blockquote>
      </div>
    </div>
  </div>

  <div class="text-center mb-16 relative w-full flex flex-col items-center">
    <h2
      class="scroll-float text-[4rem] text-white font-bold inline-block relative pb-6 m-0 capitalize drop-shadow-[0_3px_6px_rgba(0,29,61,0.5)] after:content-[''] after:absolute after:bottom-0 after:left-1/2 after:-translate-x-1/2 after:w-[80px] after:h-[5px] after:bg-gradient-to-r after:from-marine-deep after:via-marine-teal after:to-marine-deep after:bg-[length:200%_auto] after:rounded-full after:shadow-[0_0_10px_rgba(0,206,209,0.5)] after:animate-[flowLine_3s_linear_infinite]"
      data-key="about.gallery"
    >
      Galería
    </h2>
  </div>

  <div
    class="h-[800px] w-full max-w-[140rem] px-4 md:px-8 mx-auto relative rounded-3xl overflow-hidden mb-20"
  >
    <InfiniteMenu
      client:only="react"
      items={[
        {
          image: imgDog.src,
          link: "#",
          title: "First Steps",
          description:
            "Remembering where it all started. Every little step counts.",
        },
        {
          image: imgFriendst.src,
          link: "#",
          title: "True Bonds",
          description:
            "The best moments are lived in the best company. Unforgettable instances.",
        },
        {
          image: imgJapon.src,
          link: "#",
          title: "Next Destination: Japan",
          description:
            "A clear goal on the horizon. A culture I admire and a dream soon to be reality.",
        },
        {
          image: imgMoure.src,
          link: "#",
          title: "Tech Community",
          description:
            "I've had the chance to meet amazing people like Brais (MoureDev). Community learning is my engine.",
        },
        {
          image: imgParacaidas.src,
          link: "#",
          title: "Pure Adrenaline",
          description:
            "Stepping out of the comfort zone. I love extreme challenges, whether it's skydiving or fixing a tough bug.",
        },
        {
          image: imgPoli2.src,
          link: "#",
          title: "Leadership",
          description:
            "During my degree I managed to build a great community. Growing as a team is key to success.",
        },
        {
          image: imgPoli.src,
          link: "#",
          title: "Bachelor's Degree",
          description:
            "Proud to have graduated with excellence, closing a flawless cycle at the Polytechnic.",
        },
        {
          image: imgViaje.src,
          link: "#",
          title: "Adventurous Spirit",
          description:
            "Traveling and discovering new places is my passion. Each destination is a new perspective of the world.",
        },
      ]}
      scale={1}
    />
  </div>
</section>

<!-- Sección Skills (Logo Loop) -->
<div class="bg-transparent mb-20 w-full overflow-hidden relative mt-24">
  <div class="text-center mb-16 relative w-full flex flex-col items-center">
    <h2
      class="scroll-float text-[4rem] text-white font-bold inline-block relative pb-6 m-0 capitalize drop-shadow-[0_3px_6px_rgba(0,29,61,0.5)] after:content-[''] after:absolute after:bottom-0 after:left-1/2 after:-translate-x-1/2 after:w-[80px] after:h-[5px] after:bg-gradient-to-r after:from-marine-deep after:via-marine-teal after:to-marine-deep after:bg-[length:200%_auto] after:rounded-full after:shadow-[0_0_10px_rgba(0,206,209,0.5)] after:animate-[flowLine_3s_linear_infinite]"
      data-key="skills.title"
    >
      Skills
    </h2>
  </div>

  <div class="relative flex w-full overflow-hidden group mask-image-fade py-8">
    <!-- First Marquee Track -->
    <div
      class="flex animate-marquee whitespace-nowrap group-hover:[animation-play-state:paused]"
    >
      {
        [
          {
            name: "Astro",
            img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/astro/astro-original.svg",
          },
          {
            name: "Java",
            img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/java/java-original.svg",
          },
          {
            name: "Python",
            img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/python/python-original.svg",
          },
          {
            name: "MySQL",
            img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/mysql/mysql-original.svg",
          },
          {
            name: "Git",
            img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/git/git-original.svg",
          },
          {
            name: "GitHub",
            img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/github/github-original.svg",
          },
          {
            name: "Node.js",
            img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nodejs/nodejs-original.svg",
          },
          {
            name: "JavaScript",
            img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/javascript/javascript-original.svg",
          },
          {
            name: "HTML",
            img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/html5/html5-original.svg",
          },
          {
            name: "CSS",
            img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/css3/css3-original.svg",
          },
          {
            name: "TypeScript",
            img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/typescript/typescript-original.svg",
          },
          {
            name: "Tailwind",
            img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/tailwindcss/tailwindcss-original.svg",
          },
          {
            name: "PostgreSQL",
            img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/postgresql/postgresql-original.svg",
          },
        ].map((skill) => (
          <div class="flex flex-col items-center justify-center mx-8 sm:mx-12 min-w-[120px] transition-transform duration-300 hover:scale-110">
            <div class="w-[70px] h-[70px] mb-4 bg-white/10 backdrop-blur-sm p-3 rounded-2xl shadow-lg border border-white/20 flex items-center justify-center">
              <img
                src={skill.img}
                alt={skill.name}
                class="w-full h-full object-contain drop-shadow-md"
                loading="lazy"
                onerror="this.onerror=null; this.src='https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/devicon/devicon-original.svg';"
              />
            </div>
            <span class="text-white font-bold text-[1.4rem] tracking-wide drop-shadow-md">
              {skill.name}
            </span>
          </div>
        ))
      }
    </div>

    <!-- Second Marquee Track (Duplicate for seamless loop) -->
    <div
      class="flex animate-marquee2 whitespace-nowrap absolute top-8 group-hover:[animation-play-state:paused]"
    >
      {
        [
          {
            name: "Astro",
            img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/astro/astro-original.svg",
          },
          {
            name: "Java",
            img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/java/java-original.svg",
          },
          {
            name: "Python",
            img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/python/python-original.svg",
          },
          {
            name: "MySQL",
            img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/mysql/mysql-original.svg",
          },
          {
            name: "Git",
            img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/git/git-original.svg",
          },
          {
            name: "GitHub",
            img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/github/github-original.svg",
          },
          {
            name: "Node.js",
            img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nodejs/nodejs-original.svg",
          },
          {
            name: "JavaScript",
            img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/javascript/javascript-original.svg",
          },
          {
            name: "HTML",
            img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/html5/html5-original.svg",
          },
          {
            name: "CSS",
            img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/css3/css3-original.svg",
          },
          {
            name: "TypeScript",
            img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/typescript/typescript-original.svg",
          },
          {
            name: "Tailwind",
            img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/tailwindcss/tailwindcss-original.svg",
          },
          {
            name: "PostgreSQL",
            img: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/postgresql/postgresql-original.svg",
          },
        ].map((skill) => (
          <div class="flex flex-col items-center justify-center mx-8 sm:mx-12 min-w-[120px] transition-transform duration-300 hover:scale-110">
            <div class="w-[70px] h-[70px] mb-4 bg-white/10 backdrop-blur-sm p-3 rounded-2xl shadow-lg border border-white/20 flex items-center justify-center">
              <img
                src={skill.img}
                alt={skill.name}
                class="w-full h-full object-contain drop-shadow-md"
                loading="lazy"
                onerror="this.onerror=null; this.src='https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/devicon/devicon-original.svg';"
              />
            </div>
            <span class="text-white font-bold text-[1.4rem] tracking-wide drop-shadow-md">
              {skill.name}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .mask-image-fade {
    mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
  }
  .animate-marquee {
    animation: marquee 35s linear infinite;
  }
  .animate-marquee2 {
    animation: marquee2 35s linear infinite;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-100%);
    }
  }
  @keyframes marquee2 {
    0% {
      transform: translateX(100%);
    }
    100% {
      transform: translateX(0%);
    }
  }

  .animate-marquee-right {
    animation: marquee-right 45s linear infinite;
  }
  .animate-marquee-right2 {
    animation: marquee-right2 45s linear infinite;
  }
  @keyframes marquee-right {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(0%);
    }
  }
  @keyframes marquee-right2 {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(100%);
    }
  }
</style>
