---
import ballena1 from "../../assets/Ballena3.webp";
import pez from "../../assets/pez.webp";
import RotatingText from "../ui/RotatingText.jsx";
---

<section
  id="home"
  class="w-[min(95%,160rem)] mx-auto flex flex-col-reverse md:flex-row items-center gap-16 min-h-screen pt-32 pb-16 relative z-10"
>
  <!-- Columna Izquierda: Texto y Botones -->
  <div class="text-center md:text-left flex-1">
    <div
      class="scroll-reveal inline-block bg-white/10 text-white px-6 py-2 rounded-full font-bold mb-8 border border-white/20 capitalize backdrop-blur-sm"
      data-key="home.badge"
    >
      Welcome to my ocean
    </div>

    <h1
      class="scroll-reveal text-[4rem] md:text-[6rem] m-0 text-white leading-tight font-heading drop-shadow-md"
      data-key="home.greeting"
    >
      Hi, I'm Eric Perucho Solis
    </h1>

    <h2
      class="text-[3rem] text-white m-0 font-heading drop-shadow-md flex flex-wrap items-center gap-3"
    >
      <span data-key="home.iam">I am a</span>
      <RotatingText
        client:load
        texts={[
          "Perucho Developer",
          "Full Stack Dev",
          "Tech Enthusiast",
          "Problem Solver",
        ]}
        mainClassName="overflow-hidden justify-center bg-[#00ffff] text-[#03050c] px-4 py-0.5 rounded-lg font-bold shadow-[0_0_20px_rgba(0,255,255,0.3)]"
        staggerFrom="last"
        initial={{ y: "100%" }}
        animate={{ y: 0 }}
        exit={{ y: "-120%" }}
        staggerDuration={0.025}
        splitLevelClassName="overflow-hidden"
        transition={{ type: "spring", damping: 30, stiffness: 400 }}
        rotationInterval={3000}
        animatePresenceMode="popLayout"
      />
    </h2>

    <p
      class="scroll-reveal mt-8 mb-12 text-gray-300 text-[1.8rem] max-w-[50ch] mx-auto md:ml-0 md:mr-auto leading-relaxed"
      data-key="home.description"
    >
      I specialize in diving deep into code to create profound and fluid web
      experiences.
    </p>

    <div class="flex flex-col md:flex-row gap-6 items-center">
      <a
        href={import.meta.env.BASE_URL + "/Curriculo_Vitae_Eric_Perucho.pdf"}
        download
        class="bg-[#00ffff] text-[#03050c] px-12 py-5 border-2 border-[#00ffff] rounded-md text-lg font-bold cursor-pointer transition-all inline-flex items-center justify-center gap-4 text-center shadow-[0_4px_15px_rgba(0,255,255,0.3)] hover:bg-white hover:border-white hover:-translate-y-1 hover:shadow-[0_6px_20px_rgba(255,255,255,0.4)]"
        data-key="home.cv">Descargar CV</a
      >

      <a
        href="#contact"
        class="bg-transparent border-2 border-white/50 text-white shadow-none hover:bg-white hover:text-[#03050c] hover:border-white hover:shadow-[0_4px_15px_rgba(255,255,255,0.3)] px-12 py-5 rounded-md text-lg font-bold cursor-pointer transition-all inline-flex items-center justify-center gap-4 text-center hover:-translate-y-1"
        data-key="home.contact">Contacto</a
      >

      <!-- LinkedIn Icon -->
      <a
        href="https://www.linkedin.com/in/eric-perucho-128706133"
        target="_blank"
        class="bg-transparent border-2 border-[#0077b5] text-[#0077b5] shadow-none hover:bg-[#0077b5] hover:text-white hover:border-[#0077b5] hover:shadow-[0_4px_15px_rgba(0,119,181,0.3)] px-12 py-5 rounded-md text-lg font-bold cursor-pointer transition-all inline-flex items-center justify-center gap-4 text-center hover:-translate-y-1"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          style="width:20px; height:20px; fill:currentColor; margin-right:8px;"
        >
          <path
            d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
          ></path>
        </svg>
        LinkedIn
      </a>
    </div>
  </div>

  <!-- Columna Derecha: Imagen Yo Cayendo -->
  <div class="flex-1 flex justify-center items-center w-full mt-12 md:mt-24">
    <div class="w-full flex justify-center items-center relative">
      <img
        id="falling-hero-img"
        src={ballena1.src}
        alt="Ballena"
        class="max-w-none w-[300px] md:w-[500px] lg:w-[600px] h-auto drop-shadow-[0_20px_30px_rgba(0,29,61,0.3)] animate-floatAfterFall"
      />

      <!-- Pez Acompañante -->
      <div
        id="fish-companion"
        class="absolute top-[15%] md:top-[25%] right-0 opacity-0 pointer-events-none transition-all duration-[6000ms] ease-out z-20 translate-x-[200px]"
      >
        <div class="relative w-fit">
          <img
            id="fish-img"
            src={pez.src}
            alt="Pez acompañante"
            class="w-[20px] md:w-[25px] h-auto cursor-pointer drop-shadow-lg hover:scale-125 transition-transform animate-swim"
          />
          <div
            id="fish-bubble"
            class="absolute -top-36 -left-32 md:-left-44 w-64 md:w-80 bg-white/90 backdrop-blur-md text-[#03050c] p-5 rounded-2xl shadow-[0_0_15px_rgba(0,255,255,0.4)] opacity-0 transition-all duration-300 pointer-events-none text-sm md:text-base font-bold origin-bottom-right scale-50 before:content-[''] before:absolute before:-bottom-2 before:right-6 before:border-[10px] before:border-transparent before:border-t-white/90"
          >
            Fun fact! The whale shark is the largest fish in the world, it can
            measure up to 18 meters and live more than 100 years.
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Audio del chapuzón para la caída -->
<audio id="hero-falling-audio" src={import.meta.env.BASE_URL + "/audio/splash.mp3"} preload="auto"></audio>

<style>
  .animate-fallIntoSea {
    animation: fallIntoSea 1s cubic-bezier(0.5, 0, 0.75, 0) forwards;
  }
  .animate-floatAfterFall {
    animation: float 6s ease-in-out infinite;
  }
  .animate-swim {
    animation: swim 4s ease-in-out infinite alternate;
  }

  @keyframes swim {
    0% {
      transform: translate(0, 0) rotate(0deg);
    }
    100% {
      transform: translate(-15px, 10px) rotate(-10deg);
    }
  }

  @keyframes fallIntoSea {
    0% {
      transform: translateY(-150vh) rotate(-15deg);
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
    100% {
      transform: translateY(0) rotate(0deg);
      opacity: 1;
    }
  }
</style>

<script>
  const fallingImg = document.getElementById("falling-hero-img");
  const fallingAudio = document.getElementById(
    "hero-falling-audio",
  ) as HTMLAudioElement;
  const fishCompanion = document.getElementById("fish-companion");
  const fishImg = document.getElementById("fish-img");
  const fishBubble = document.getElementById("fish-bubble");

  const whaleSharkFacts = {
    es: [
      "¡Dato curioso! El tiburón ballena es el pez más grande del mundo, puede medir hasta 18 metros y vivir más de 100 años.",
      "¡Dato curioso! Sus manchas son únicas, como las huellas dactilares de los humanos. ¡No hay dos tiburones ballena iguales!",
      "¡Dato curioso! A pesar de su enorme tamaño, solo se alimenta de plancton y pequeños peces microscópicos, por lo que es inofensivo para los humanos.",
      "¡Dato curioso! Nadan a unos 5 km/h, paseando muy lentamente y relajados por los océanos cálidos.",
      "¡Dato curioso! Su boca puede medir hasta 1.5 metros de ancho, ¡casi del tamaño de una persona promedio!",
      "¡Dato curioso! Tienen la piel increíblemente gruesa, de hasta 15 centímetros de espesor en algunas partes de su cuerpo.",
    ],
    en: [
      "Fun fact! The whale shark is the largest fish in the world, can measure up to 18 meters and live more than 100 years.",
      "Fun fact! Their spots are unique, like human fingerprints. No two whale sharks are the same!",
      "Fun fact! Despite their enormous size, they only feed on plankton and tiny microscopic fish, making them harmless to humans.",
      "Fun fact! They swim at about 5 km/h, cruising very slowly and relaxed through warm oceans.",
      "Fun fact! Their mouths can be up to 1.5 meters wide, almost the size of an average person!",
      "Fun fact! They have incredibly thick skin, up to 15 centimeters thick in some parts of their body.",
    ],
  };

  // Toggle fish bubble on click and randomize fact based on current language
  if (fishImg && fishBubble) {
    const updateFact = () => {
      const lang = localStorage.getItem("portfolio_lang") || "en";
      const facts =
        whaleSharkFacts[lang as keyof typeof whaleSharkFacts] ||
        whaleSharkFacts["en"];
      const randomFact = facts[Math.floor(Math.random() * facts.length)];
      fishBubble.textContent = randomFact;
    };

    fishImg.addEventListener("click", () => {
      if (fishBubble.classList.contains("opacity-0")) {
        updateFact();
      }
      fishBubble.classList.toggle("opacity-0");
      fishBubble.classList.toggle("scale-50");
      fishBubble.classList.toggle("opacity-100");
      fishBubble.classList.toggle("scale-100");
    });

    // Escuchar el evento de cambio de idioma para actualizar en tiempo real si está abierto
    window.addEventListener("languageChanged", () => {
      // Solo actualizamos si la burbuja está visible
      if (!fishBubble.classList.contains("opacity-0")) {
        updateFact();
      }
    });
  }

  if (fallingImg) {
    document.addEventListener(
      "start-falling-hero",
      () => {
        // Reproducir audio casi al terminar la caída del contenedor completo (simulando que choca con el agua)
        if (fallingAudio) {
          setTimeout(() => {
            fallingAudio.volume = 1.0;
            fallingAudio
              .play()
              .catch((e) => console.log("Audio de caída bloqueado: ", e));
          }, 1500); // 1.5s para coincidir con el momento de impacto en el agua
        }

        // Mostrar al pez después de que todo haya caído (2.2s de animación)
        if (fishCompanion) {
          setTimeout(() => {
            fishCompanion.classList.remove(
              "opacity-0",
              "pointer-events-none",
              "translate-x-[200px]",
            );
            fishCompanion.classList.add("translate-x-0");
            fishCompanion.classList.replace("right-0", "right-[5%]"); // Mueve el punto de anclaje
          }, 3200);
        }
      },
      { once: true },
    );
  }
</script>
