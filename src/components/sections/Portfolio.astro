            >
              <img
                src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/postgresql/postgresql-original.svg"
                class="w-6 h-6"
                alt="PostgreSQL"
              />
              PostgreSQL
            </span>
          </div>

          <!-- Botones Enlace -->
          <div class="flex flex-wrap justify-center xl:justify-start gap-6">
            <a
              href="https://pronagas.asea.gob.mx/logingas"
