---
import ScrollStack, { ScrollStackItem } from "../ui/ScrollStack.jsx";
import imgBasquet from "../../assets/LandinBasquetbol.png";
import imgRenagas from "../../assets/RENAGAS.png";
import imgHuellitas from "../../assets/MarcandoHuellitas.png";
import imgULA from "../../assets/ULA.png";
import imgPrivad from "../../assets/404Private.png";
import portafolio from "../../assets/portafolio.png";
---

<section
  id="portafolio"
  class="w-[min(95%,160rem)] mx-auto mt-16 px-4 md:px-8 py-16 relative min-h-[40vh] z-10"
>
  <div class="text-center mb-20 relative w-full">
    <h2
      class="scroll-float text-[4rem] text-white font-bold inline-block relative pb-6 m-0 capitalize drop-shadow-[0_3px_6px_rgba(0,29,61,0.5)] after:content-[''] after:absolute after:bottom-0 after:left-1/2 after:-translate-x-1/2 after:w-[80px] after:h-[5px] after:bg-gradient-to-r after:from-marine-deep after:via-marine-teal after:to-marine-deep after:bg-[length:200%_auto] after:rounded-full after:shadow-[0_0_10px_rgba(0,206,209,0.5)] after:animate-[flowLine_3s_linear_infinite]"
      data-key="portfolio.title"
    >
      Portafolio
    </h2>
  </div>

  <div
    class="h-[1000px] xl:h-[850px] w-full relative rounded-3xl overflow-hidden border border-white/10 shadow-2xl bg-black/20 backdrop-blur-sm"
  >
    <ScrollStack client:load>
      <!-- Proyecto 1 -->
      <ScrollStackItem
        itemClassName="bg-[#03050c]/95 text-white flex flex-col xl:flex-row justify-center items-center gap-12 p-8 md:p-16 border-2 border-[#00ffff]/30 relative overflow-hidden"
      >
        <!-- Decoraciones de luz en el fondo -->
        <div
          class="absolute top-0 right-0 w-64 h-64 bg-[#00ffff]/10 rounded-full blur-[80px] pointer-events-none"
        >
        </div>
        <div
          class="absolute bottom-0 left-0 w-64 h-64 bg-[#00ced1]/10 rounded-full blur-[80px] pointer-events-none"
        >
        </div>

        <!-- Columna de Texto -->
        <div
          class="z-10 text-center xl:text-left flex-1 flex flex-col items-center xl:items-start max-w-4xl"
        >
          <div
            class="inline-block bg-[#00ffff]/10 text-[#00ffff] px-4 py-1.5 rounded-full font-bold mb-6 text-sm border border-[#00ffff]/20 backdrop-blur-sm uppercase tracking-wider"
          >
            Proyecto Integrador Generation
          </div>
          <h2
            class="text-[3.5rem] md:text-[4.5rem] font-bold mb-6 text-white drop-shadow-md leading-tight"
          >
            Marcando <span
              class="text-transparent bg-clip-text bg-gradient-to-r from-[#FFCFD2] to-[#FFCFD2]"
              >Huellitas</span
            >
          </h2>
          <p
            class="text-[1.8rem] text-gray-300 mb-10 leading-relaxed max-w-[70ch]"
          >
            Una pagina web desarrollada para un refugio de animales llamado
            "Marcando Huellitas", con el objetivo de promover la adopción de
            perros. En esta puedes encontrar informacion sobre los perros
            disponibles para adopción, sus historias, caracteristicas y como
            adoptarlos.
          </p>

          <!-- Stack Tecnológico -->
          <div
            class="flex flex-wrap justify-center xl:justify-start gap-4 mb-12"
          >
            <span
              class="flex items-center gap-2 px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-[1.4rem] font-semibold text-[#e0f7fa]"
            >
              <img
                src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/html5/html5-original.svg"
                class="w-6 h-6"
                alt="HTML5"
              />
              HTML5
            </span>
            <span
              class="flex items-center gap-2 px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-[1.4rem] font-semibold text-[#e0f7fa]"
            >
              <img
                src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/css3/css3-original.svg"
                class="w-6 h-6"
                alt="CSS3"
              />
              CSS3
            </span>
            <span
              class="flex items-center gap-2 px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-[1.4rem] font-semibold text-[#e0f7fa]"
            >
              <img
                src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/javascript/javascript-original.svg"
                class="w-6 h-6"
                alt="JavaScript"
              />
              JavaScript
            </span>
            <span
              class="flex items-center gap-2 px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-[1.4rem] font-semibold text-[#e0f7fa]"
            >
              <img
                src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/bootstrap/bootstrap-original.svg"
                class="w-6 h-6"
                alt="Bootstrap"
              />
              Bootstrap
            </span>
            <span
              class="flex items-center gap-2 px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-[1.4rem] font-semibold text-[#e0f7fa]"
            >
              <img
                src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/github/github-original.svg"
                class="w-6 h-6"
                alt="GitHub"
                style="filter: invert(1)"
              />
              GitHub
            </span>
            <span
              class="flex items-center gap-2 px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-[1.4rem] font-semibold text-[#e0f7fa]"
            >
              <img
                src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/mysql/mysql-original-wordmark.svg"
                class="w-6 h-6"
                alt="MySQL"
                style="filter: invert(1)"
              />
              MySQL
            </span>
            <span
              class="flex items-center gap-2 px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-[1.4rem] font-semibold text-[#e0f7fa]"
            >
              <img
                src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/java/java-original.svg"
