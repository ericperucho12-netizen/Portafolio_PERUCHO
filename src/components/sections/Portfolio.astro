            </span>
          </div>

          <!-- Botones Enlace -->
          <div class="flex flex-wrap justify-center xl:justify-start gap-6">
            <a
              href="https://landinbasquetbol.netlify.app"
              target="_blank"
              class="group inline-flex items-center gap-3 bg-gradient-to-r from-[#001d3d] to-[#00ced1] text-white px-8 py-4 rounded-full font-bold text-[1.6rem] transition-all duration-300 hover:scale-105 hover:shadow-[0_0_25px_rgba(0,206,209,0.5)] border border-[#00ffff]/30"
            >
