          class="z-10 flex-1 w-full max-w-3xl xl:max-w-none group mt-8 xl:mt-0"
        >
          <div
            class="relative rounded-2xl overflow-hidden border-2 border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.5)] transition-transform duration-500 group-hover:scale-105 group-hover:shadow-[0_20px_50px_rgba(0,255,255,0.2)]"
