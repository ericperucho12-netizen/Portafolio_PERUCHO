---
import bannerTiktok from "../../assets/Banner titok.png";
---

<section id="blog" class="pt-8 pb-20 relative z-10 w-[min(95%,120rem)] mx-auto">
  <div class="text-center mb-16">
    <h2
      class="scroll-float text-[4rem] text-white font-bold inline-block relative pb-6 m-0 capitalize drop-shadow-[0_3px_6px_rgba(0,29,61,0.5)] after:content-[''] after:absolute after:bottom-0 after:left-1/2 after:-translate-x-1/2 after:w-[80px] after:h-[5px] after:bg-gradient-to-r after:from-marine-deep after:via-marine-teal after:to-marine-deep after:bg-[length:200%_auto] after:rounded-full after:shadow-[0_0_10px_rgba(0,206,209,0.5)] after:animate-[flowLine_3s_linear_infinite]"
      data-key="blog.title"
    >
      Blog
    </h2>
  </div>
  <!-- Banner del canal -->
  <div
    class="w-full mx-auto mb-12 rounded-3xl overflow-hidden shadow-[0_10px_30px_rgba(0,255,255,0.2)] border-2 border-white/10 group cursor-pointer relative"
  >
    <a
      href="https://www.tiktok.com/@hello_perucho"
      target="_blank"
      class="block relative"
    >
      <img
        src={bannerTiktok.src}
        alt="Banner de TikTok"
        class="w-full h-auto object-cover transform transition-transform duration-700 group-hover:scale-105"
      />
      <div
        class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center"
      >
        <span
          class="text-white font-bold text-2xl bg-[#fe2c55] px-6 py-3 rounded-full shadow-lg"
          >¡Visitar Perfil!</span
        >
      </div>
    </a>
  </div>
  <h2
    class="scroll-float text-[3rem] md:text-[4rem] text-white font-heading mb-4 drop-shadow-md"
    data-key="blog.title"
  >
    Mi TikTok
  </h2>
  <p
    class="scroll-reveal text-gray-300 text-xl max-w-2xl mx-auto mb-8"
    data-key="blog.desc"
  >
    Comparto mi viaje, conocimiento y curiosidades sobre programación y
    desarrollo. ¡Sígueme en mi canal oficial!
  </p>

  <!-- Botón de TikTok -->
  <a
    href="https://www.tiktok.com/@hello_perucho"
    target="_blank"
    class="inline-flex items-center gap-3 bg-[#fe2c55] text-white px-8 py-4 rounded-full font-bold text-lg transition-transform hover:scale-105 hover:shadow-[0_0_20px_rgba(254,44,85,0.5)]"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 448 512"
      fill="currentColor"
    >
      <path
        d="M448,209.91a210.06,210.06,0,0,1-122.77-39.25V349.38A162.55,162.55,0,1,1,185,188.31V278.2a74.62,74.62,0,1,0,52.23,71.18V0l88,0a121.18,121.18,0,0,0,1.86,22.17h0A122.18,122.18,0,0,0,381,102.39a121.43,121.43,0,0,0,67,20.14Z"
      ></path>
    </svg>
    @hello_perucho
  </a>
</section>

<div
  class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 lg:gap-20 mt-16 w-full max-w-[120rem] mx-auto place-items-center px-4"
>
  <!-- TikTok Embed Video 1 -->
  <div
    class="w-full w-[325px] flex-shrink-0 rounded-2xl overflow-hidden shadow-[0_10px_30px_rgba(0,0,0,0.5)] bg-black/30 transform transition-transform hover:-translate-y-2"
  >
    <blockquote
      class="tiktok-embed"
      cite="https://www.tiktok.com/@hello_perucho/video/7636858961123249425"
      data-video-id="7636858961123249425"
      style="max-width: 605px;min-width: 325px;"
    >
      <section>
        <a
          target="_blank"
          title="@hello_perucho"
          href="https://www.tiktok.com/@hello_perucho?refer=embed"
        >
          @hello_perucho
        </a>
      </section>
    </blockquote>
  </div>

