---
import yoCallendo from "../assets/Yo_callendo.png";
import ballena from "../assets/ballena.png";
import ballena1 from "../assets/ballena3.webp";
---

<section
  id="home"
  class="w-[min(95%,160rem)] mx-auto flex flex-col-reverse md:flex-row items-center gap-16 min-h-[80vh] pt-8 relative z-10"
>
  <!-- Columna Izquierda: Texto y Botones -->
  <div class="text-center md:text-left flex-1">
    <div
      class="inline-block bg-white/10 text-white px-6 py-2 rounded-full font-bold mb-8 border border-white/20 capitalize backdrop-blur-sm"
      data-key="home.badge"
    >
      Bienvenido a mi océano
    </div>

    <h1
      class="text-[4rem] md:text-[6rem] m-0 text-white leading-tight font-heading drop-shadow-md"
      data-key="home.greeting"
    >
      Hola, soy Eric Perucho Solis
    </h1>

    <h2 class="text-[3rem] text-white m-0 font-heading drop-shadow-md">
      <span data-key="home.iam">I am a</span>
      <span
        class="text-[#00ffff] font-bold drop-shadow-[0_0_15px_rgba(0,255,255,0.4)] after:content-['Perucho_Developer'] after:font-bold"
      ></span>
    </h2>

    <p
      class="mt-8 mb-12 text-gray-300 text-lg max-w-[50ch] mx-auto md:ml-0 md:mr-auto"
      data-key="home.description"
    >
      Me especializo en sumergirme en el código para crear experiencias web
      profundas y fluidas.
    </p>

    <div class="flex flex-col md:flex-row gap-6 items-center">
      <a
        href="/Curriculo_Vitae_Eric_Perucho.pdf"
        download
        class="bg-[#00ffff] text-[#03050c] px-12 py-5 border-2 border-[#00ffff] rounded-md text-lg font-bold cursor-pointer transition-all inline-flex items-center justify-center gap-4 text-center shadow-[0_4px_15px_rgba(0,255,255,0.3)] hover:bg-white hover:border-white hover:-translate-y-1 hover:shadow-[0_6px_20px_rgba(255,255,255,0.4)]"
        data-key="home.cv">Descargar CV</a
      >

      <a
        href="#contact"
        class="bg-transparent border-2 border-white/50 text-white shadow-none hover:bg-white hover:text-[#03050c] hover:border-white hover:shadow-[0_4px_15px_rgba(255,255,255,0.3)] px-12 py-5 rounded-md text-lg font-bold cursor-pointer transition-all inline-flex items-center justify-center gap-4 text-center hover:-translate-y-1"
        data-key="home.contact">Contacto</a
      >

      <!-- LinkedIn Icon -->
      <a
        href="https://www.linkedin.com/in/eric-perucho-128706133"
        target="_blank"
        class="bg-transparent border-2 border-[#0077b5] text-[#0077b5] shadow-none hover:bg-[#0077b5] hover:text-white hover:border-[#0077b5] hover:shadow-[0_4px_15px_rgba(0,119,181,0.3)] px-12 py-5 rounded-md text-lg font-bold cursor-pointer transition-all inline-flex items-center justify-center gap-4 text-center hover:-translate-y-1"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          style="width:20px; height:20px; fill:currentColor; margin-right:8px;"
        >
          <path
            d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
          ></path>
        </svg>
        LinkedIn
      </a>
    </div>
  </div>

  <!-- Columna Derecha: Imagen Yo Cayendo -->
  <div class="flex-1 flex justify-center items-center w-full">
    <div class="w-full flex justify-center items-center relative">
      <img
        id="falling-hero-img"
        src={ballena1.src}
        alt="Ballena"
        class="max-w-none w-[300px] md:w-[500px] lg:w-[600px] h-auto drop-shadow-[0_20px_30px_rgba(0,29,61,0.3)] opacity-0"
      />
    </div>
  </div>
</section>

<!-- Audio del chapuzón para la caída -->
<audio id="hero-falling-audio" src="/audio/splash.mp3" preload="auto"></audio>

<style>
  .animate-fallIntoSea {
    animation: fallIntoSea 1s cubic-bezier(0.5, 0, 0.75, 0) forwards;
  }
  .animate-floatAfterFall {
    animation: float 6s ease-in-out infinite;
  }

  @keyframes fallIntoSea {
    0% {
      transform: translateY(-150vh) rotate(-15deg);
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
    100% {
      transform: translateY(0) rotate(0deg);
      opacity: 1;
    }
  }
</style>

<script>
  const fallingImg = document.getElementById("falling-hero-img");
  const fallingAudio = document.getElementById(
    "hero-falling-audio",
  ) as HTMLAudioElement;

  if (fallingImg) {
    document.addEventListener(
      "start-falling-hero",
      () => {
        // Esperar un poco a que la pantalla de carga empiece a desaparecer
        setTimeout(() => {
          fallingImg.classList.remove("opacity-0");
          fallingImg.classList.add("animate-fallIntoSea");

          // Reproducir audio casi al terminar la caída (simulando que choca con el agua)
          if (fallingAudio) {
            setTimeout(() => {
              fallingAudio.volume = 1.0;
              fallingAudio
                .play()
                .catch((e) => console.log("Audio de caída bloqueado: ", e));
            }, 800); // 800ms después de que inicia la caída
          }

          // Después de la caída, mantenerlo visible y agregar animación de flotar
          setTimeout(() => {
            fallingImg.classList.remove("animate-fallIntoSea");
            fallingImg.classList.add("animate-floatAfterFall");
          }, 1000); // La caída dura 1s
        }, 500); // 500ms de retraso inicial para coordinar con la pantalla de carga
      },
      { once: true },
    );
  }
</script>
